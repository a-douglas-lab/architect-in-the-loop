# Line endings: LF in the repository and on checkout, on every platform.
# Windows-only scripts are the exception and use CRLF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# Spec Kit hashes the files it installs (SHA-256) to detect local edits.
# Keep its PowerShell scripts byte-identical to how it writes them (LF),
# or every checkout looks like a modification and blocks upgrades.
.specify/scripts/powershell/*.ps1 text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
